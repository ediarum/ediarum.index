{
  "name": "ediarum-index-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:watch": "vite build --watch",
    "check-embed": "node scripts/check-embed.mjs"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "axios": "^1.20.0",
    "vue": "^3.5.30",
    "vue-router": "^5.3.1",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.3.4",
    "happy-dom": "^20.14.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.98.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.2.5"
  }
}
