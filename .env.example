# Copy to .env (git-ignored). docker-compose.yml (deployment) needs at least
# DATABASE_URL, AUTH_VERIFY_URL, PLATFORM_NETWORK and XML_VOLUME;
# docker-compose.dev.yml (local) uses the MYSQL_* keys instead.

# --- deployment (docker-compose.yml) -------------------------------------------
# DATABASE_URL=mysql+pymysql://index:PASSWORD@db.example.org:3306/ediarum_index?charset=utf8mb4&ssl_ca=/certs/ca.pem
# DB_CERTS_DIR=./certs            # mounted at /certs (the database's CA certificate)
# PLATFORM_NETWORK=ediarum-platform
# XML_VOLUME=ediarum_xml          # ediarum.fileservice's volume
# INDEX_VERSION=X.Y.Z             # released images (default: latest)


# --- database ------------------------------------------------------------------
MARIADB_VERSION=latest
MYSQL_ROOT_PASSWORD=ANOTHER_PASSWORD
MYSQL_DATABASE=DBNAME
MYSQL_USER=DBUSER
MYSQL_PASSWORD=A_PASSWORD
# Where `ediarum-index migrate` / `serve` write the mariadb-dump backup before
# pending migrations (compose sets /backups, the db_backups volume).
# BACKUP_DIR=/backups
# Or one URL instead of the MYSQL_* keys + DB_HOST (default `database`):
# DATABASE_URL=mysql+pymysql://DBUSER:A_PASSWORD@database:3306/DBNAME?charset=utf8mb4

# --- ediarum.platform ----------------------------------------------------------
# Who sent a request: the platform's auth verify endpoint (see docs/reference/auth.md).
AUTH_VERIFY_URL=https://PLATFORM_HOST/api/auth/verify
# Local development only, instead of AUTH_VERIFY_URL: every request is this
# admin user. Never in production. Neither set: only API keys are accepted.
# AUTH_DEV_USER=you@example.org

# The platform's project registry, mirrored into the `project` table. Unset:
# the modules in src/ediarum_index/projects/ are the project list.
# PLATFORM_PROJECTS_URL=https://PLATFORM_HOST/api/auth/service/projects
# PLATFORM_SERVICE_TOKEN=A_LONG_RANDOM_SECRET

# Path prefix the platform's proxy strips (/api/index/ -> /), for /docs.
# ROOT_PATH=/api/index

# ediarum.id: entries created in the app get their source_id there. An
# ediarum.id key for the projects: `ediarum-id keys add index --admin`.
# Unset: entries created in the app get no source_id.
# ID_URL=http://ediarum-id-api:8000
# ID_KEY=AN_EDIARUM_ID_API_KEY

# --- XML: the ingest and `ediarum-index watch` --------------------------------
# The shared volume ediarum.fileservice keeps (read-only here): one checkout
# per project slug. Locally: clones at ./xml/<slug>/.
XML_MOUNT_ROOT=/data/xml
# Optional: fileservice's status endpoint lets the watcher skip unchanged
# projects (a per-project or admin key of fileservice's own).
# FILESERVICE_URL=http://fileservice:8000
# FILESERVICE_KEY=A_FILESERVICE_API_KEY
# RECONCILE_INTERVAL=300           # seconds between the watcher's checks
# INDEX_PROJECT=leibniz5          # `ediarum-index ingest`'s default profile
